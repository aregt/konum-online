#!/bin/sh
# Commit sonrası FTP yedek + yükleme (Windows Git Bash / Git for Windows)
ROOT="$(git rev-parse --show-toplevel)"
ENV_FILE="$ROOT/.ftp-deploy.env"
if [ ! -f "$ENV_FILE" ]; then
  echo "[deploy] .ftp-deploy.env yok — FTP atlandı."
  exit 0
fi
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$ROOT/scripts/deploy.ps1"
exit $?
